# ═══════════════════════════════════════════════════════════════════════════
#  EIPV — URLs propres (sans extension .html)
#  Objectif : afficher /enseignements au lieu de /enseignements.html
# ═══════════════════════════════════════════════════════════════════════════

<IfModule mod_rewrite.c>
  Options +FollowSymLinks -MultiViews
  RewriteEngine On

  # 1) /index.html -> /   et   /fr/index.html -> /fr/   (redirection 301)
  RewriteCond %{THE_REQUEST} \s/(?:([^?\s]+/))?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 2) /page.html -> /page   (redirection 301 pour ne plus jamais montrer .html)
  RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 3) Servir en interne le fichier .html quand on demande l'URL propre
  #    (uniquement si le fichier .html existe et que ce n'est pas un dossier)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Page 404 personnalisee (facultatif : sert la page d'accueil si besoin)
# ErrorDocument 404 /
